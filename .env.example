# Copy to .env and fill real values. Never commit .env.
# Placeholders only — do not invent production secrets.

PORT=3000
DATABASE_URL=postgres://devbot:devbot@localhost:5432/devbot

# Cursor Cloud Agents API (Basic auth username; password empty)
CURSOR_API_KEY=your_cursor_api_key_here
# Optional model override; omit or leave blank to use Cursor default
CURSOR_MODEL=
# Must be 32+ characters; used to sign Cursor → DevBot webhooks
CURSOR_WEBHOOK_SECRET=replace_with_32_plus_char_cursor_webhook_secret

# GitHub
GITHUB_WEBHOOK_SECRET=replace_with_github_webhook_secret
GITHUB_TOKEN=ghp_your_github_token_here
DEFAULT_REPO=https://github.com/org/repo
DEFAULT_REF=main

# Isometrik chat adapter
# CHAT_POST_URL must be Isometrik's send-message API (see src/clients/chat.ts TODO)
CHAT_POST_URL=https://apis.isometrik.io/REPLACE_WITH_SEND_MESSAGE_PATH
CHAT_BOT_TOKEN=your_isometrik_bot_token_here
# Isometrik senderId of the bot — inbound events from this id are ignored
BOT_USER_ID=devbot
# Comma-separated sender IDs; empty = allow all users
ALLOWED_USER_IDS=

# Public HTTPS base URL DevBot is reachable at (ngrok or deployed host)
PUBLIC_BASE_URL=https://your-ngrok-or-host.example.com

# Max automatic CI fix follow-ups per request
MAX_CI_RETRIES=2
