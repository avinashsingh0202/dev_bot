# Copy to .env and fill real values. Never commit .env.
# Placeholders only — do not invent production secrets.

PORT=3000
DATABASE_URL=postgres://devbot:devbot@localhost:5432/devbot

# Cursor Cloud Agents API (Basic auth username; password empty)
CURSOR_API_KEY=your_cursor_api_key_here
# Optional model override; omit or leave blank to use Cursor default
CURSOR_MODEL=
# Must be 32+ characters; used to sign Cursor → DevBot webhooks
CURSOR_WEBHOOK_SECRET=replace_with_32_plus_char_cursor_webhook_secret

# GitHub
GITHUB_WEBHOOK_SECRET=replace_with_github_webhook_secret
GITHUB_TOKEN=ghp_your_github_token_here
DEFAULT_REPO=https://github.com/org/repo
DEFAULT_REF=main

# Isometrik chat adapter (all optional for POC listen/trigger testing)
# If CHAT_POST_URL or CHAT_BOT_TOKEN is empty, outbound posts are logged+skipped;
# inbound still creates requests and launches Cursor agents.
# CHAT_POST_URL = Isometrik send-message API when ready (see src/clients/chat.ts TODO)
CHAT_POST_URL=
CHAT_BOT_TOKEN=
# Isometrik senderId of the bot — inbound events from this id are ignored (optional)
BOT_USER_ID=
# POC allowlists (comma-separated). Empty = allow all for that dimension.
# Non-matching senders/conversations are ignored with no reply.
ALLOWED_USER_IDS=661e62abed6eab0034a910ef
ALLOWED_CONVERSATION_IDS=6af4f6f3e94e470001d1326e

# Optional. Defaults to http://localhost:3000 so the process can start before ngrok.
# Cursor / GitHub / Isometrik webhooks still need a real public HTTPS URL —
# set this to your ngrok or deployed host once you have one (leave blank to use default).
PUBLIC_BASE_URL=

# Max automatic CI fix follow-ups per request
MAX_CI_RETRIES=2
